# Copy to .env and adjust. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
DATABASE_URL=postgresql+psycopg://clearpipe:clearpipe@localhost:5432/clearpipe
ANTHROPIC_API_KEY=

# Budget controls (all optional)
# LLM_DAILY_BUDGET_USD=5.00     # hard daily cap; further model calls fail with 429 until tomorrow
# LLM_CACHE_ENABLED=true
# LLM_CACHE_DIR=.cache/llm
# LLM_COST_LOG=costs.jsonl
